# Copy this file to backend/.env on the deployment VM and adjust values.
# This file is only used by the production Docker container
# (local dev via run.sh works fine without it — settings.py has safe defaults).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=*
DB_PATH=/app/data/db.sqlite3

# Optional: override the auto-created default superuser (username: admin,
# password: admin if left unset). Change these before your first deploy if
# you don't want the default admin/admin credentials in place.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=admin
